# Plantilla de credenciales. Copiar a .env y completar.
# Cargar con: flutter run --dart-define-from-file=.env
#
# SUPABASE_URL             -> Project URL del panel de Supabase (Settings > API)
# SUPABASE_PUBLISHABLE_KEY -> la clave que empieza con sb_publishable_
#
# Esta clave publica esta disenada para ir en el cliente: concede solo el rol
# anon, y todas las reglas de seguridad las aplican las politicas RLS de la
# base, no la clave. Aun asi no se versiona, para que rotarla no exija tocar
# el codigo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
