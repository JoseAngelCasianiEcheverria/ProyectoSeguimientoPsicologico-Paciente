# `*.env` NO cubre un archivo llamado `.env` (el `*` no atraviesa el punto
# inicial), asi que se lista explicito.
.env
.env.*
!.env.example
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
