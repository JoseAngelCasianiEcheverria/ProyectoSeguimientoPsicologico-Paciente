.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generados por Flutter para escritorio (linux/, macos/, windows/)
#
# El tool de Flutter reescribe estos archivos en cada `flutter pub get` y en
# cada compilacion de escritorio. Los escribe con LF y el indice los guarda
# tambien con LF, pero Git los marca como modificados en cada ejecucion solo
# por el salto de linea. El README ya dice que no se editan a mano ni hacen
# falta en los commits, asi que se dejan de versionar: los regenera el tool.
linux/flutter/generated_plugin_registrant.*
linux/flutter/generated_plugins.cmake
macos/Flutter/GeneratedPluginRegistrant.swift
windows/flutter/generated_plugin_registrant.*
windows/flutter/generated_plugins.cmake
